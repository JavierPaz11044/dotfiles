#
# Based on /usr/share/doc/bspwm/examples/sxhkdrc
# plus custom app / media / KDE settings bindings
#

#
# wm independent hotkeys
#

# terminal emulator
super + Return
	kitty

# floating terminal
super + shift + Return
	bspc rule -a kitty -o state=floating follow=on center=true && kitty

# program launcher (rofi) — centered on keyboard
super + @space
	sh $HOME/.local/bin/launcher center

# program launcher (rofi) — classic Super+r (centered)
super + r
	sh $HOME/.local/bin/launcher center

# eww dashboard popup
super + d
	sh $HOME/.local/bin/dashboard

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

#
# applications
#

# Brave
super + shift + b
	brave-browser

# Cursor IDE
super + c
	/usr/bin/cursor

# VS Code
super + shift + c
	/usr/bin/code

# File manager (Dolphin)
super + e
	dolphin

# KDE Network settings
super + shift + n
	systemsettings kcm_networkmanagement

# KDE Bluetooth settings (headphones / devices)
super + shift + t
	systemsettings kcm_bluetooth

#
# media / system
#

# Screenshot: select region (quick save + clipboard)
super + s
	$HOME/.local/bin/takeshot --area

# Screenshot: region + edit (arrows/text) + auto clipboard
super + shift + s
	$HOME/.local/bin/takeshot-edit

# Screenshot: full screen
Print
	$HOME/.local/bin/takeshot --now

# Screenshot: select area (alternate)
shift + Print
	$HOME/.local/bin/takeshot --area

# Screenshot: active window
ctrl + Print
	$HOME/.local/bin/takeshot --win

# Screenshot: delayed 5s
alt + Print
	$HOME/.local/bin/takeshot --in5

# Screenshot: delayed 10s
ctrl + alt + Print
	$HOME/.local/bin/takeshot --in10

XF86MonBrightness{Up,Down}
	sh $HOME/.local/bin/brightness {up,down}

# Hardware media keys
XF86Audio{Raise,Lower}Volume
	$HOME/.local/bin/volume {up,down}

XF86AudioMute
	$HOME/.local/bin/volume mute

# Keyboard fallbacks (if laptop keys don't send XF86*)
super + shift + {Up,Down}
	$HOME/.local/bin/volume {up,down}

super + shift + m
	$HOME/.local/bin/volume mute

# Lock screen / suspend
# Super+Alt+L — lock (also Super+Shift+X)
super + alt + l
	$HOME/.local/bin/lock-screen

super + shift + x
	$HOME/.local/bin/lock-screen

super + shift + z
	$HOME/.local/bin/suspend-screen

super + alt + shift + l
	$HOME/.local/bin/suspend-screen

# Laptop lock key (Fn+F6 / XF86ScreenSaver on some keyboards)
XF86ScreenSaver
	$HOME/.local/bin/lock-screen

# Sleep key (if present)
XF86Sleep
	$HOME/.local/bin/suspend-screen

#
# bspwm hotkeys
#

# quit/restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# close and kill (Super+w / Super+Shift+w)
super + {_,shift + }w
	bspc node -{c,k}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# send the newest marked node to the newest preselected node
super + y
	bspc node newest.marked.local -n newest.!automatic.local

# swap the current node and the biggest window
super + g
	bspc node -s biggest.window

#
# state/flags
#

# set the window state
super + {t,shift + t,f}
	bspc node -t {tiled,pseudo_tiled,fullscreen}

# toggle floating (was Super+s)
super + shift + space
	bspc node -t '~'floating

# set the node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

#
# focus/swap
#

# focus the node in the given direction
super + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

# focus the node for the given path jump
super + {p,b,comma,period}
	bspc node -f @{parent,brother,first,second}

# focus the next/previous window in the current desktop
super + alt + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus the last node/desktop
super + {grave,Tab}
	bspc {node,desktop} -f last

# focus the older or newer node in the focus history
super + {o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

# focus or send to the given desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

#
# preselect
#

# preselect the direction
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

# preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + space
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# move/resize
#

# expand a window by moving one of its side outward
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its side inward
super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
super + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}
