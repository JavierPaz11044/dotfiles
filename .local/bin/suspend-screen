#!/usr/bin/env bash
# Lock the screen, then suspend.

set -euo pipefail

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-${HOME}/.Xauthority}"

LOCK="${HOME}/.local/bin/lock-screen"

if [[ -x "$LOCK" ]]; then
  "$LOCK" &
  sleep 1
elif command -v loginctl >/dev/null 2>&1; then
  loginctl lock-session
  sleep 0.3
fi

systemctl suspend
